# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Data / large artifacts -- never commit these; see docs/data.md
data/
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
# Pipeline run outputs are not committed, EXCEPT the small vendored CSVs that
# scripts/paper/ needs to regenerate the paper's figures and tables.
results/*
!results/paper_inputs/
results/paper_figures/
*.zip
third_party/

# ckpts/ is tracked intentionally -- final checkpoints committed for reproducibility.
# The one file over GitHub's 100 MB limit ships split (.part00/.part01);
# scripts/fetch_checkpoints.py reassembles it, and the assembled file is ignored below.
!ckpts/
!ckpts/**
wandb/
outputs/
mlruns/

# Env / secrets
.env

# Editor / assistant local state
.claude/
.vscode/
.idea/

# OS
.DS_Store

# reassembled by scripts/fetch_checkpoints.py from the committed .part files
ckpts/classifiers/effnet_b5_aptos.pt
